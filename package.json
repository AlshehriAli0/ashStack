{
  "name": "ashstack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "rm -rf packages/lint/dist && tsc -p packages/lint",
    "check:fixtures": "bun run build && bun scripts/check-fixtures.ts",
    "check:mutants": "bun run build && bun scripts/check-mutants.ts",
    "check:pack": "bun scripts/check-pack.ts",
    "check:smoke": "bun run build && bun scripts/check-smoke.ts",
    "docs:rules": "bun run build && bun scripts/generate-rule-docs.ts",
    "docs:rules:check": "bun run build && bun scripts/generate-rule-docs.ts --check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "bun run build && oxlint --disable-nested-config --type-aware .",
    "lint:fix": "bun run build && oxlint --disable-nested-config --type-aware --fix .",
    "release": "changeset publish",
    "test": "bun run build && bun test --parallel tests/",
    "typecheck": "bun run build && tsc -p . --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "@ashstack/fmt": "workspace:*",
    "@ashstack/lint": "workspace:*"
  }
}
