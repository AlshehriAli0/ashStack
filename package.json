{
  "name": "ashstack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check:fixtures": "bun scripts/check-fixtures.ts",
    "check:smoke": "bun scripts/check-smoke.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "changeset publish",
    "docs:rules": "bun scripts/generate-rule-docs.ts",
    "docs:rules:check": "bun scripts/generate-rule-docs.ts --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "@ashstack/fmt": "workspace:*"
  }
}
