{
  "name": "@ashstack/lint",
  "version": "0.0.0",
  "description": "ashStack shared oxlint configuration and custom rules. Entries: core, react, react-native, with per-library rule groups auto-detected from your dependencies. Consume from oxlint.config.mts.",
  "type": "module",
  "license": "MIT",
  "author": "Ali Alshehri (https://github.com/AlshehriAli0)",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./core": "./src/core/index.js",
    "./react": "./src/react/index.js",
    "./react-native": "./src/react-native/index.js"
  },
  "files": [
    "src",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
