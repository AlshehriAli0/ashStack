{
  "name": "@ashstack/lint",
  "version": "0.0.0",
  "description": "ashStack shared oxlint configuration and custom rules. Entries: core, react, react-native, with per-library rule groups auto-detected from your dependencies. Consume from oxlint.config.mts.",
  "type": "module",
  "license": "MIT",
  "author": "Ali Alshehri (https://github.com/AlshehriAli0)",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./react": "./dist/react/index.js",
    "./react-native": "./dist/react-native/index.js"
  },
  "files": [
    "dist",
    "RULES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
