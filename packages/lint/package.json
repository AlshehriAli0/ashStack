{
  "name": "@ashstack/lint",
  "version": "0.7.0",
  "description": "ashStack shared oxlint configuration and custom rules. Entries: core, react, react-native, with per-library rule groups auto-detected from your dependencies. Consume from oxlint.config.mts.",
  "type": "module",
  "license": "MIT",
  "author": "Ali Alshehri (https://github.com/AlshehriAli0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlshehriAli0/ashStack.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/AlshehriAli0/ashStack/tree/main/packages/lint#readme",
  "bugs": "https://github.com/AlshehriAli0/ashStack/issues",
  "keywords": [
    "oxlint",
    "oxc",
    "lint",
    "linter",
    "eslint-config",
    "typescript",
    "react",
    "react-native",
    "expo"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "!dist/index.js",
    "!dist/index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "scripts": {
    "prepack": "rm -rf dist && tsc && bun build $(find dist -name '*.js') --minify --target=node --root dist --outdir dist --no-bundle && bun ../../scripts/prune-types.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
